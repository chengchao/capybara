{
  "name": "capybara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "setup:runtimes": "bun run ./scripts/fetch-runtimes.ts",
    "check:electron": "tsc --noEmit -p electron",
    "check:renderer": "tsc --noEmit",
    "lint": "oxlint -D correctness",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "tsc && vite build",
    "dev": "vite",
    "dist:prepare": "bun run setup:runtimes && bun run check:electron && bun run build",
    "dist": "bun run dist:prepare && electron-builder",
    "test:supervisor:image": "docker build -f resources/supervisor/Dockerfile.test -t capybara-supervisor-test resources/supervisor",
    "test:supervisor": "docker run --rm --privileged -v \"$PWD/resources/supervisor:/app:ro\" -w /app capybara-supervisor-test sh -lc 'CAPYBARA_SUPERVISOR_INTEGRATION=1 pytest -q -p no:cacheprovider'",
    "test:supervisor:ci": "docker run --rm -v \"$PWD/resources/supervisor:/app:ro\" -w /app capybara-supervisor-test sh -lc 'pytest -q -p no:cacheprovider'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.139",
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.1"
  },
  "trustedDependencies": [
    "electron"
  ]
}
